# Copie para .env (make setup). O .env fica fora do Git.

# Porta do app web. Cada worktree usa a sua, de 1420 a 1424; a 1420 fica para quem roda o Tauri (D56).
PORTA_APP=1420

# Supabase local (make db-start). A chave anon aparece em make db-status.
# Nunca coloque a chave service_role numa variável VITE_: tudo que começa com VITE_ vai para o app.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Flyway no Supabase local (docker compose run --rm flyway ...).
FLYWAY_URL=jdbc:postgresql://host.docker.internal:54322/postgres
FLYWAY_USER=postgres
FLYWAY_PASSWORD=postgres
