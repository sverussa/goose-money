# Copie para supabase/tests/.env (make setup). Só os testes de banco leem este arquivo.
# Chaves do Supabase local: make db-status (ANON_KEY e SERVICE_ROLE_KEY).
# A service_role ignora o RLS: fica só aqui, nunca numa variável VITE_ nem no app.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
